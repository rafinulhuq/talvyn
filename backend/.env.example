# ─── Application ──────────────────────────────────────────────
APP_ENV=development
APP_NAME=Talvyn API
APP_VERSION=0.1.0
DEBUG=true

# ─── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── Database ─────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://talvyn_user:talvyn_pass@localhost:5432/talvyn_db

# ─── Security ─────────────────────────────────────────────────
# Must match INTERNAL_API_SECRET in frontend .env.local
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=change_me_in_production_32_char_min

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# ─── Ollama ───────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_TIMEOUT_SECONDS=600   # 10 min — test generation takes 2-6 min per test
OLLAMA_MAX_RETRIES=3

# ─── Question bank / sectioned exam (Master Prompt 2/3, opt-in) ──
# Disabled by default — set true to enable the reusable 3-section bank
# (Reasoning/Practical/Technical) and the /exam/<token> candidate flow.
QUESTION_BANK_MODE=false

# ─── GLM "cloud" tier (Master Prompt 3, opt-in) ────────────────
# Disabled by default — every GLM-routed task falls back to the local
# Ollama model above when this is unconfigured.
#
# Recommended: self-host a bigger open-source model on Ollama's own
# OpenAI-compatible endpoint (zero cost, no rate limit — just hardware):
#   ollama pull glm4:9b   # ~5.5 GB at Q4 — fits an 8 GB GPU comfortably
#   GLM_ENABLED=true
#   GLM_API_BASE_URL=http://localhost:11434/v1
#   GLM_API_KEY=ollama   # not validated by Ollama, any non-empty value works
#   GLM_MODEL=glm4:9b
#
# Alternative: a real hosted cloud model via Hugging Face Inference
# Providers (needs a real token from huggingface.co/settings/tokens with
# Inference Providers billing enabled):
#   GLM_API_BASE_URL=https://router.huggingface.co/v1
#   GLM_API_KEY=<your hf_... token>
#   GLM_MODEL=zai-org/GLM-5.2
GLM_ENABLED=false
GLM_API_BASE_URL=http://localhost:11434/v1
GLM_API_KEY=ollama
GLM_MODEL=glm4:9b
GLM_TIMEOUT_SECONDS=120
GLM_MAX_RETRIES=2

# ─── Semantic similarity (pgvector, opt-in) ────────────────────
# Disabled by default. Enable to rank "candidates like this one" on the
# evaluation report. Requires postgres image pgvector/pgvector:pg16
# (already the default in docker-compose.yml) and a pulled embedding model:
#   ollama pull nomic-embed-text
EMBEDDING_ENABLED=false
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ─── AI-likeness estimate for open-ended answers (opt-in) ──────
# Disabled by the Python default, enabled by docker-compose.yml with Desklib.
# A PROBABILISTIC writing-style signal, never a verdict — see
# backend/app/services/ai_detection_service.py.
AI_LIKENESS_ENABLED=false
AI_DETECTION_BACKEND=llm
DESKLIB_MODEL_NAME=desklib/ai-text-detector-v1.01

# ─── File Storage ─────────────────────────────────────────────
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ─── Email ──────────────────────────────────────────────────
# Option 1: Resend (default if SMTP_HOST is blank)
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Talvyn Platform

# Option 2: SMTP relay (used instead of Resend whenever SMTP_HOST is set).
# Recommended for production at zero cost: sign up at brevo.com, verify a
# sender email/domain, then grab SMTP credentials from
# Settings > SMTP & API > SMTP. Free tier: 300 emails/day, no card required.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=your-brevo-login@example.com
# SMTP_PASSWORD=your-brevo-smtp-key

# ─── Magic Links ──────────────────────────────────────────────
MAGIC_LINK_BASE_URL=http://localhost:3000
MAGIC_LINK_EXPIRY_HOURS=72
# Generate with: openssl rand -hex 32
MAGIC_LINK_SECRET=change_me_in_production_32_char_min

# ─── HighGarden OTP gate ────────────────────────────────────────
# Every HighGarden unlock attempt emails a one-time code to this address —
# it is never taken from the request, so a hijacked Super Admin session
# still can't redirect the code to itself.
HIGHGARDEN_OTP_EMAIL=syedrafinulhuq@gmail.com
