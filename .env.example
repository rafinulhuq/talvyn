# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=talvyn_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=talvyn_db

# ─── Shared secret (Next.js ↔ FastAPI JWT verification) ───────
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# ─── Cloudflare Tunnel (public access, docker-compose.prod.yml only) ──
# one.dash.cloudflare.com -> Networks -> Tunnels -> your tunnel -> the
# install command's --token value. Only needed on the production server.
CLOUDFLARE_TUNNEL_TOKEN=

# ─── Email delivery (signup approvals, candidate invitations) ──
# Without one of the two paths below, every transactional email — including
# the "your account was approved" notice — is skipped with a warning in the
# backend logs and never reaches the recipient.
#
# Path 1 — SMTP. Takes precedence whenever SMTP_HOST is non-empty. In local
# development the docker-compose stack runs Mailpit, which needs no
# credentials and no domain verification:
#   SMTP_HOST=mailpit
#   SMTP_PORT=1025
# For a real relay, set SMTP_USERNAME/SMTP_PASSWORD too (STARTTLS is applied
# automatically when the server advertises it).
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# Path 2 — Resend HTTP API. Used in production when SMTP_HOST is empty.
# EMAIL_FROM must be an address on a domain verified in your Resend account.
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Talvyn Platform

# Base URL used to build links inside emails (the "Sign in" button in the
# approval email, and candidate magic links). Must be the public app URL in
# production — a wrong value sends users to a host they can't reach.
# With the www/app split this is the APP host: these links all resolve to
# app-only routes (/login, /apply/<slug>, /reset-password, magic links).
# e.g. MAGIC_LINK_BASE_URL=https://app.talvyn.com
MAGIC_LINK_BASE_URL=http://localhost:3000

# ─── Public origins for the frontend production BUILD ─────────
# Next.js inlines NEXT_PUBLIC_* at build time, and .dockerignore keeps
# frontend/.env.local out of the image, so these must be set HERE — this is
# the file docker-compose.prod.yml reads when passing build.args.
# Setting them only in frontend/.env.local has no effect on a Docker build.
#
# Leaving SITE and APP identical disables the hostname split (dev default).
NEXT_PUBLIC_SITE_URL=http://localhost:3003
NEXT_PUBLIC_APP_URL=http://localhost:3003
