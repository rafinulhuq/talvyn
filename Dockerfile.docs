# Builds the MkDocs site and serves it as static files. Kept out of GitHub
# Pages deliberately — the repo is private and GitHub Pages on private repos
# needs a paid org plan. This serves the same build through the existing
# Cloudflare Tunnel instead (see docker-compose.prod.yml's `docs` service).

FROM python:3.12-slim AS build
WORKDIR /docs
COPY requirements-docs.txt .
RUN pip install --no-cache-dir -r requirements-docs.txt
COPY mkdocs.yml .
COPY docs ./docs
RUN mkdocs build --clean

FROM nginx:alpine
COPY --from=build /docs/site /usr/share/nginx/html
