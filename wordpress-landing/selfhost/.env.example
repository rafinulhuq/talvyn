# Copy to .env in this folder and fill in. .env is gitignored (verified
# against .gitignore:19) — never commit the real values.
#
# Generate the passwords:
#   openssl rand -base64 32

WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=
WORDPRESS_DB_ROOT_PASSWORD=

# Host port cloudflared proxies to. Must not collide with the app stack
# (3003 frontend, 8000 backend, 5432 postgres, 6379 redis).
WORDPRESS_PORT=8080

# Leave as localhost while testing. Change to https://www.talvyn.com only
# AFTER the Cloudflare public hostname points at this container — WordPress
# rewrites its own URLs from this and locks you out if it is wrong.
WORDPRESS_SITE_URL=http://localhost:8080
