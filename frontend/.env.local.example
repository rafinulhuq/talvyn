# ─── NextAuth ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change_me_in_production_base64_string
NEXTAUTH_URL=http://localhost:3000

# ─── Public origins (www / app split) ─────────────────────────
# Two hostnames served by this one Next.js container in production:
#
#   NEXT_PUBLIC_SITE_URL — public marketing site + blog. Drives sitemap.xml,
#                          robots.txt, blog canonical links and the RSS feed.
#   NEXT_PUBLIC_APP_URL  — application origin. Drives auth redirects,
#                          sign-out and admin "copy link" URLs.
#
# Leave them identical (as below) and the hostname split in
# src/lib/hosts.ts disables itself — correct for local dev, CI and
# Playwright. Set them to different hosts to turn it on:
#   NEXT_PUBLIC_SITE_URL=https://www.talvyn.com
#   NEXT_PUBLIC_APP_URL=https://app.talvyn.com
#
# IMPORTANT: NEXT_PUBLIC_* are inlined by `next build`, not read at runtime.
# For Docker builds set them in the REPO ROOT .env so they reach
# docker-compose.prod.yml's build.args — setting them only here has no
# effect on a containerised production build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── FastAPI backend ──────────────────────────────────────────
# Internal URL (server-side Next.js → FastAPI, not exposed to browser)
FASTAPI_INTERNAL_URL=http://localhost:8000
# Public URL (browser → FastAPI via Next.js proxy, or direct)
NEXT_PUBLIC_API_URL=http://localhost:3000/backend

# ─── Shared secret (must match backend INTERNAL_API_SECRET) ───
INTERNAL_API_SECRET=change_me_in_production_32_char_min

# ─── Database (for Prisma from Next.js) ───────────────────────
DATABASE_URL=postgresql://talvyn_user:talvyn_pass@localhost:5432/talvyn_db

# ─── Seed admin (frontend/prisma/seed.ts, runs on every startup) ──
# Set this before first deploy so the seeded SUPER_ADMIN has a password only
# you know. If left unset, a random one is generated and printed once to the
# frontend container logs instead of being hardcoded.
SEED_ADMIN_EMAIL=acmeai@talvyn.com
SEED_ADMIN_PASSWORD=

# ─── Highgarden analytics (Super Admin only) ──────────────────
# Generate with:
#   node -e "require('bcryptjs').hash(process.argv[1], 12).then(console.log)" 'your-passphrase'
HIGHGARDEN_PASSPHRASE_HASH=
# Optional dedicated cookie-signing secret. Falls back to NEXTAUTH_SECRET.
HIGHGARDEN_COOKIE_SECRET=
